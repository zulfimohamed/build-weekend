{
  // Cloudflare Workers config: no code, just serve the repo as static assets.
  "name": "build-weekend",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "."
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
